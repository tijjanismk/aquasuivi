DATABASE_URL="postgresql://aqua:aqua@localhost:5432/aquasuivi?schema=public"

# Signe les jetons d'accès (D18). 32 caractères minimum, sinon l'API refuse de démarrer.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="a-remplacer"

# Premier compte administrateur, créé ou remis à jour par `pnpm db:seed`.
AQUA_ADMIN_TELEPHONE="70000000"
AQUA_ADMIN_MOT_DE_PASSE="a-remplacer"
