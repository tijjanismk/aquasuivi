# Copier en deploy/.env et remplir. Ce fichier ne doit jamais être versionné.

# Trois sous-domaines pointant (DNS, enregistrement A) vers le serveur.
DOMAINE_PWA=terrain.exemple.ml
DOMAINE_ADMIN=admin.exemple.ml
DOMAINE_API=api.exemple.ml
# Contact Let's Encrypt (avis d'expiration de certificat).
ACME_EMAIL=contact@exemple.ml

POSTGRES_USER=aqua
# Générer : openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=aquasuivi

# 32 caractères au moins. Générer : openssl rand -base64 48
# Le changer déconnecte tout le monde (au plus 15 minutes).
JWT_SECRET=

# Premier administrateur, créé par le seed (voir deploy/README.md).
AQUA_ADMIN_TELEPHONE=
AQUA_ADMIN_MOT_DE_PASSE=

# Limites de tentatives (défauts raisonnables).
AQUA_LIMITE_CONNEXIONS=10
AQUA_LIMITE_INSCRIPTIONS=30
